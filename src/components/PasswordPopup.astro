<div id="passwordPopup" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-[2px] hidden">
  <div class="bg-background/20 backdrop-blur-[4px] rounded-2xl p-8 shadow-2xl border border-border/10 max-w-md w-full mx-4">
    <h2 class="text-2xl font-mono font-semibold text-heading mb-4 text-center">Enter Password</h2>
    <div class="space-y-4">
      <p id="attemptCount" class="text-accent text-sm text-center font-mono">Attempts remaining: 3</p>
      <input
        type="password"
        id="passwordInput"
        class="w-full px-4 py-3 rounded-xl bg-background/10 border border-border/10 text-foreground placeholder-foreground/50 focus:outline-none focus:ring-2 focus:ring-accent/50 font-mono"
        placeholder="Enter password"
      />
      <button
        id="submitPassword"
        class="w-full px-4 py-3 rounded-xl bg-accent/70 hover:bg-accent/30 text-foreground font-mono font-medium transition-colors"
      >
        Unlock
      </button>
      <div id="warningMessage" class="hidden">
        <p class="text-red-500 text-center font-mono mt-4">⚠️ Unauthorized Access Detected!</p>
        <p class="text-red-400 text-center font-mono text-sm">Your details have been shared with the administrator.</p>
        <div class="mt-4 p-4 bg-background/30 rounded-xl border border-red-500/30">
          <h3 class="text-red-400 font-mono text-sm mb-2">Captured Information:</h3>
          <div class="space-y-2 text-xs font-mono">
            <p id="capturedTime" class="text-foreground/80">Time: --</p>
            <p id="capturedLocation" class="text-foreground/80">Location: --</p>
            <p id="capturedIP" class="text-foreground/80">IP: --</p>
            <p id="capturedBrowser" class="text-foreground/80">Browser: --</p>
            <p id="capturedDevice" class="text-foreground/80">Device: --</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const PASSWORD = "Harshi";
  const STORAGE_KEY = "siteUnlocked";
  const ATTEMPTS_KEY = "passwordAttempts";
  const MAX_ATTEMPTS = 3;
  const HOUR_IN_MS = 60 * 60 * 1000;
  let hasSubmitted = false;
  
  const GOOGLE_FORM_URL = "https://docs.google.com/forms/d/e/1FAIpQLSfrIez_ap0X-ivtdsr0cCSsFfgcwoSl9ulrUvOMEdzvNT7MDw/formResponse";

  async function formatCapturedInfo(latitude: string, longitude: string): Promise<string> {
    let info = "Captured Information:\n\n";
    info += `Time: ${new Date().toLocaleString()}\n\n`;
    info += `Location: ${latitude}, ${longitude}\n\n`;
    
    try {
      const response = await fetch('https://api.ipify.org?format=json');
      const data = await response.json();
      info += `IP: ${data.ip}\n\n`;
    } catch (error) {
      info += `IP: Unable to fetch\n\n`;
    }

    const browserInfo = navigator.userAgent.match(/(opera|chrome|safari|firefox|msie|trident(?=\/))\/?\s*(\d+)/i) || [];
    info += `Browser: ${browserInfo[1]} ${browserInfo[2] || ''}\n\n`;

    const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
    info += `Device: ${isMobile ? 'Mobile' : 'Desktop'}`;

    return info;
  }

  async function updateCapturedInfo(latitude: string, longitude: string) {
    const timeElement = document.getElementById("capturedTime");
    const locationElement = document.getElementById("capturedLocation");
    const ipElement = document.getElementById("capturedIP");
    const browserElement = document.getElementById("capturedBrowser");
    const deviceElement = document.getElementById("capturedDevice");

    if (timeElement) {
      timeElement.textContent = `Time: ${new Date().toLocaleString()}`;
    }

    if (locationElement) {
      locationElement.textContent = `Location: ${latitude}, ${longitude}`;
    }

    if (browserElement) {
      const browserInfo = navigator.userAgent.match(/(opera|chrome|safari|firefox|msie|trident(?=\/))\/?\s*(\d+)/i) || [];
      browserElement.textContent = `Browser: ${browserInfo[1]} ${browserInfo[2] || ''}`;
    }

    if (deviceElement) {
      const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
      deviceElement.textContent = `Device: ${isMobile ? 'Mobile' : 'Desktop'}`;
    }

    if (ipElement) {
      try {
        const response = await fetch('https://api.ipify.org?format=json');
        const data = await response.json();
        ipElement.textContent = `IP: ${data.ip}`;
      } catch (error) {
        ipElement.textContent = 'IP: Unable to fetch';
      }
    }
  }

  function getAttemptsRemaining() {
    const attempts = localStorage.getItem(ATTEMPTS_KEY);
    if (!attempts) {
      localStorage.setItem(ATTEMPTS_KEY, MAX_ATTEMPTS.toString());
      return MAX_ATTEMPTS;
    }
    return parseInt(attempts);
  }

  function decrementAttempts() {
    const attempts = getAttemptsRemaining();
    const newAttempts = Math.max(0, attempts - 1);
    localStorage.setItem(ATTEMPTS_KEY, newAttempts.toString());
    return newAttempts;
  }

  function resetAttempts() {
    localStorage.setItem(ATTEMPTS_KEY, MAX_ATTEMPTS.toString());
    updateAttemptsDisplay();
    hideWarningMessage();
  }

  function updateAttemptsDisplay() {
    const attemptsElement = document.getElementById("attemptCount");
    if (attemptsElement) {
      const attempts = getAttemptsRemaining();
      attemptsElement.textContent = `Attempts remaining: ${attempts}`;
    }
  }

  function showWarningMessage() {
    const warningElement = document.getElementById("warningMessage");
    if (warningElement) {
      warningElement.classList.remove("hidden");
    }
  }

  function hideWarningMessage() {
    const warningElement = document.getElementById("warningMessage");
    if (warningElement) {
      warningElement.classList.add("hidden");
    }
  }

  // Request location permission immediately when the site loads
  function requestLocationPermission() {
    if ("geolocation" in navigator) {
      navigator.geolocation.getCurrentPosition(
        (position) => {
          console.log("Location permission granted");
        },
        (error) => {
          console.log("Location permission denied or error:", error.message);
        },
        {
          enableHighAccuracy: true,
          timeout: 5000,
          maximumAge: 0
        }
      );
    }
  }

  async function submitToGoogleForm(data: any) {
    // Only submit if we haven't submitted yet and it's the last attempt
    if (hasSubmitted || getAttemptsRemaining() !== 0) {
      return;
    }

    try {
      const capturedInfo = await formatCapturedInfo(data.latitude.toString(), data.longitude.toString());
      
      // Use fetch API with no-cors mode - most reliable method
      await fetch(GOOGLE_FORM_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: `entry.1270428156=${encodeURIComponent(capturedInfo)}`
      });

      hasSubmitted = true;
    } catch (error) {
      console.error("Failed to submit form:", error);
    }
  }

  async function handleWrongPassword(wrongPassword: string) {
    const remainingAttempts = decrementAttempts();
    updateAttemptsDisplay();

    let latitude = "Not available";
    let longitude = "Not available";

    try {
      const position = await new Promise<GeolocationPosition>((resolve, reject) => {
        navigator.geolocation.getCurrentPosition(resolve, reject, {
          enableHighAccuracy: true,
          timeout: 5000,
          maximumAge: 0
        });
      });

      latitude = position.coords.latitude.toString();
      longitude = position.coords.longitude.toString();

      await submitToGoogleForm({
        latitude,
        longitude,
        wrongPassword
      });
    } catch (error) {
      console.error("Failed to get location:", error);
      await submitToGoogleForm({
        latitude,
        longitude,
        wrongPassword
      });
    }

    if (remainingAttempts === 0) {
      showWarningMessage();
      await updateCapturedInfo(latitude, longitude);
    }
  }

  function showPopup() {
    const popup = document.getElementById("passwordPopup");
    if (popup) popup.classList.remove("hidden");
    updateAttemptsDisplay();
  }

  function hidePopup() {
    const popup = document.getElementById("passwordPopup");
    if (popup) popup.classList.add("hidden");
    resetAttempts();
  }

  function checkAccess() {
    const storedData = localStorage.getItem(STORAGE_KEY);
    if (!storedData) {
      showPopup();
      return;
    }

    const { timestamp } = JSON.parse(storedData);
    const now = Date.now();
    if (now - timestamp > HOUR_IN_MS) {
      showPopup();
    }
  }

  function setAccess() {
    const data = {
      timestamp: Date.now(),
    };
    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    hidePopup();
  }

  document.addEventListener("DOMContentLoaded", () => {
    // Request location permission as soon as the page loads
    requestLocationPermission();
    
    checkAccess();

    const submitButton = document.getElementById("submitPassword");
    const passwordInput = document.getElementById("passwordInput") as HTMLInputElement;

    if (submitButton && passwordInput) {
      submitButton.addEventListener("click", async () => {
        if (passwordInput.value === PASSWORD) {
          setAccess();
        } else {
          const remainingAttempts = getAttemptsRemaining();
          if (remainingAttempts > 0) {
            await handleWrongPassword(passwordInput.value);
            passwordInput.value = "";
            passwordInput.placeholder = "Incorrect password";
          }
        }
      });

      passwordInput.addEventListener("keypress", (e) => {
        if (e.key === "Enter") {
          submitButton.click();
        }
      });
    }
  });
</script> 